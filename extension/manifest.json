{
  "manifest_version": 3,
  "name": "Qorebit wallet",
  "version": "0.1.0",
  "description": "Companion for the Qorebit one-button QoreChain hardware wallet. Talks only to the local bridge (127.0.0.1:7630); every approval happens on the device.",
  "key": "",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Qorebit wallet",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:7630/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:7630"
  }
}
